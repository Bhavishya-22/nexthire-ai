# Gemini API Key (Required for AI analysis and Career Intelligence RAG)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Generation Model (e.g., gemini-3.8-flash, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash

# Gemini Embedding Model & Vector Dimension
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Database URL:
# For Production: Supabase PostgreSQL with pgvector (e.g. postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres)
# For Local Dev / Offline: sqlite:///./nexthire.db
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# CORS Allowed Origins (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# JWT Authentication Secret
JWT_SECRET_KEY=your_super_secret_jwt_key_here
